{
  "name": "@ostro/pagination",
  "version": "1.0.7",
  "description": "Pagination module for OstroJS",
  "main": "build/lengthAwarePaginator.js",
  "types": "build/lengthAwarePaginator.d.ts",
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "types": "./build/lengthAwarePaginator.d.ts",
      "default": "./build/lengthAwarePaginator.js"
    },
    "./*": {
      "types": "./build/*.d.ts",
      "default": "./build/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "npx c8 npx jest"
  },
  "dependencies": {
    "@ostro/support": "^1.0.12"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "engineStrict": true,
  "keywords": [
    "pagination",
    "paginator"
  ],
  "author": "amar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ostrojs/pagination.git"
  },
  "bugs": {
    "url": "https://github.com/ostrojs/pagination/issues"
  },
  "homepage": "https://github.com/ostrojs/pagination#readme",
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0"
  }
}
